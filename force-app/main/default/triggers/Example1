//Write a trigger, if the owner of an account is changed then the owner for the related contacts should also be updated.

trigger updateOwner on Account(after update){
    
    if(trigger.isAfter && trigger.isUpdate){
        
        //Getting account ids that fired the trigger
        Set<Id> accountIds = new Set<Id>();
        for(Account a: Trigger.New){
            if(a.OwnerId != Trigger.oldMap.get(a.Id).OwnerId){
                accountIds.add(a.Id);
            }
        }

        //Getting contacts associated with the collected account ids
        List<Contact> relatedContacts = [Select Id, OwnerId, AccountId FROM Contact WHERE AccountId IN: accountIds];
        if(!relatedContacts.isEmpty()){
            for(Contact c: relatedContacts){
                c.OwnerId = Trigger.newMap.get(c.AccountId).OwnerId;
            }
        }

        //updating the owners of associated contacts
        if(!relatedContacts.isEmpty()){
            update relatedContacts;
        }
    }
}