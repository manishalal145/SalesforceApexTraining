//Example 1:Write a trigger, when a new Account is created then create a contact related to that account.
trigger contactCreation on Account(after insert){
    List<Contact> newContacts = new List<Contact>();
    for(Account acc: Trigger.new){
        Contact con = new Contact(LastName = acc.Name, AccountId = acc.Id);
        newContacts.add(con);
    }
    if(!newContacts.isEmpty()){
        insert newContacts;
    }
}

//Example 2:Write a trigger, if the owner of an account is changed then the owner for the related contacts should also be updated.
trigger changeOwner on Account(after update){
    Map<Id,Id> accountIds = new Map<Id,Id>();
    for(Account acc: Trigger.new){
        Account oldAcc = Trigger.oldMap.get(acc.Id);
        if(acc.OwnerId != oldAcc.OwnerId){
            accountIds.put(acc.Id, acc.OwnerId);
        }
    }

    List<Contact> associatedContacts = [SELECT AccountId, OwnerId FROM Contact WHERE AccountId IN: accountIds.keySet()];
    if(!associatedContacts.isEmpty()){
        for(Contact con: associatedContacts){
            if(accountIds.containsKey(con.AccountId)){
                con.OwnerId = accountIds.get(con.AccountId);
            }
        }
        update associatedContacts;
    }
}

//Example 3:Write a trigger, to achieve the following:
    //Create a new Opportunity whenever an account is created/updated for Industry – Agriculture.
    //Opportunity should be set as below:
    //Stage = ‘Prospecting’, Amount = $0, CloseDate = ’90 days from today’.
trigger createOpp on Account(after insert, after update){
    List<Opportunity> newOpp = new List<Opportunity>();

    for(Account acc: Trigger.New){
        
        Account oldAcc = Trigger.isUpdate ? Trigger.oldMap.get(acc.Id) : null;

        Boolean newAccount = Trigger.isInsert && acc.Industry == 'Agriculture';
        Boolean updateAccount = Trigger.isUpdate && oldAcc != null && oldAcc.Industry != 'Agriculture' && acc.Industry == 'Agriculture';

        if(newAccount || updateAccount){
            Opportunity newOp1 = new Opportunity(Name = 'New Opportunity - Agriculture', StageName = 'Prospecting', Amount = 0, CloseDate = System.today().addDays(90), AccountId = acc.Id);
            newOpp.add(newOp1);
        }
    }

    if(!newOpp.isEmpty()){
        insert newOpp;
    }
}

//Example 4:Write a trigger, to achieve the following:
    //Given: There is any associated Contact to an Account,
    //When: User tries to delete the Account,
    //Then: User should get the error that Account with associated Contact can not be deleted.
trigger deleteAccount on Account(before delete){
    Set<Id> accounts = new Set<Id>();
    for(Account acc: Trigger.old){
        accounts.add(acc.Id);
    }

    List<Contact> associatedContacts = [SELECT AccountId, Id FROM Contact Where AccountId IN:accounts];
    Set<Id> accountWithContacts = new Set<Id>();
    for(Contact con: associatedContacts){
        accountWithContacts.add(con.AccountId);
    }

    for(Account acc: Trigger.old){
        if(accountWithContacts.contains(acc.Id)){
            acc.addError('Account with associated Contact(s) cannot be deleted.');
        }    
    }
}

//Example 5: If an opportunity is closed then, no one should be able to delete it except user having System Administrator profile.
trigger deleteOpp on Opportunity(before delete){

    //Get System Admin Profile
    Profile adminProfile = [SELECT Id FROM Profile WHERE Name = 'System Administrator' LIMIT 1];

    //Get logged in user Profile Id
    Id currentUserProfileId = UserInfo.getProfileId();

    for(Opportunity opp: Trigger.old){
        if(currentUserProfileId != adminProfile.Id && (opp.StageName == 'Closed Lost' || opp.StageName == 'Closed Won')){
            opp.addError('Closed opportunity can be deleted by System Administrator only');
        }
    }
}

