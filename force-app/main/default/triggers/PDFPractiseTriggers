//If opportunity Stage is updated upon its creation or update then update description as either 'Opp is Closed Lost' or 'Opp is Closed Won' or 'Opp is Open'.
trigger updateStage on Opportunity(before insert, before update){
    for(Opportunity opp: Trigger.new){
        if(Trigger.isInsert || opp.StageName != Trigger.oldMap.get(opp.Id).StageName){
            if(opp.StageName == 'Closed Won'){
                opp.Description = 'Opp is Closed Won';
            }
            else if(opp.StageName == 'Closed Lost'){
                opp.Description = 'Opp is Closed Lost';
            }
            else{
                opp.Description = 'Opp is Open';
            }
        }
    }
}
//If the Account phone is updated then populate the phone number on all related Contacts (Home Phone field). [Using Map]
trigger updatePhone on Account(after update){
    Map<Id,String> accountPhone = new Map<Id,String>();
    for(Account a : Trigger.new){
        Account oldValues = Trigger.oldMap.get(a.Id);
        if(oldValues.Phone != a.Phone){
            accountPhone.put(a.Id,a.Phone);
        }
    }
    if(!accountPhone.isEmpty()){
        List<Contact> associatedContacts = [SELECT AccountId, HomePhone FROM Contact WHERE AccountId IN :accountPhone.keySet()];
        for(Contact con: associatedContacts){
            con.HomePhone = accountPhone.get(con.AccountId);
        }

        if(!associatedContacts.isEmpty()){
            update associatedContacts;
        }
    }
}
// If the Account billing city is updated then update related contacts mailing city. [Using Map]
trigger updateContact on Account(after update){
    Map<Id,String> accounts = new Map<Id,String>();
    for(Account acc: Trigger.new){
        Account oldValues = Trigger.oldMap.get(acc.Id);
        if(acc.BillingCity != oldValues.BillingCity){
            accounts.put(acc.Id,acc.BillingCity);
        }
    }

    if(!accounts.isEmpty()){
        List<Contact> contacts = [SELECT AccountId,MailingCity FROM Contact WHERE AccountId IN :accounts.keySet()];
        if(!contacts.isEmpty()){
            for(Contact con: contacts){
                con.MailingCity = accounts.get(con.AccountId);
            }
            update contacts;
        }
    }
}
//When a Opportunity Stage (field) is changed, create a Task record on Opportunity and assign it to Logged In User/Opportunity Owner / Any User.
trigger createTask on Opportunity(after update){
    List<Task> newTasks = new List<Task>();
    for(Opportunity opp: Trigger.new){
        Opportunity oldValues = Trigger.oldMap.get(opp.Id);
        if(opp.StageName != oldValues.StageName){
            Task t1 = new Task(OwnerId = opp.OwnerId, WhatId = opp.Id, Subject ='Stage Changed');
            newTasks.add(t1);
        }
    }
    if(!newTasks.isEmpty()){
        insert newTasks;
    }
}
//Write a trigger on Account when Account Active field is updated from ‘Yes’ to ‘No’ then check all opportunities associated with the account. Update all Opportunities Stage to close lost if stage not equal to close won.
trigger updateOpportunities on Account(after update){
    Set<Id> accountIds = new Set<Id>();
    for(Account acc: Trigger.new){
        Account oldValues = Trigger.oldMap.get(acc.Id);
        if(oldValues.Active__c =='Yes' && acc.Active__c == 'No'){
            accountIds.add(acc.Id);
        }
    }

    if(!accountIds.isEmpty()){
        List<Opportunity> associatedOpps = [SELECT AccountId, StageName FROM Opportunity WHERE StageName != 'Closed Won' AND AccountId IN: accountIds];
        for(Opportunity opp: associatedOpps){
            opp.StageName = 'Closed Lost';
        }
        update associatedOpps;
    }
}
