// Upon Account Creation if Industry is not null and having value as ‘Media’ then populate Rating as Hot.
trigger populateRating on Account(before insert){
    for(Account acc: Trigger.new){
        if(acc.Industry != null && acc.Industry == 'Media'){
            acc.Rating = 'Hot';
        }
    }
}
// Upon Opportunity Creation if Amount is not null and is greater than 100000 then populate ‘Hot Opportunity’ in description field.
trigger updateDescription on Opportunity(before insert){
    for(Opportunity opp: Trigger.new){
        if(opp.Amount != null && opp.Amount > 100000){
            opp.Description = 'Hot Opportunity';
        }
    }
}
// When an account inserts and CopyBillingToShipping (Custom Field) checkbox is checked then automatically copy account billing city into account shipping city.
trigger copyAddress on Account(before insert){
    for(Account acc: Trigger.new){
        if(acc.CopyBillingToShipping == True){
            acc.ShippingCity = acc.BillingCity;;
        }
    }
}
// Upon Creation of Position (Custom Object) if it is a New Position and Open Date, Min Pay & Max Pay are not populated then populated them with below values:
    // a. Open Date = Today’s Date
    // b. Min Pay = 10000
    // c. Max Pay = 15000
trigger populateFields on position__c(before insert){
    for(position__c pos: Trigger.new){
        if(pos.open_date__c == null){
            pos.open_date__c = System.today();
        }
        if(pos.min_Pay__c == null){
            pos.min_Pay__c = 10000;
        }
        if(pos.max_Pay__c == null){
            pos.max_Pay__c = 15000;
        }
    }
}
// Create a related Contact when an Account is created.
trigger createContact on Account(after insert){
    List<Contact> newContacts = new List<Contact>();
    for(Account acc: Trigger.new){
        Contact con = new Contact(Name = acc.Name, AccountId = acc.Id);
        newContacts.add(con);
    }
    if(!newContacts.isEmpty()){
        insert newContacts;
    }
}
// Create a related Opportunity when an Account is created.
trigger createOpportunity on Account(after insert){
    List<Opportunity> newOpportunities = new List<Opportunity>();
    for(Account acc: Trigger.new){
        Opportunity op1 = new Opportunity(Name = acc.Name, AccountId = acc.Id, StageName = 'Prospecting', CloseDate = Date.today().addDays(30));
        newOpportunities.add(op1);
    }
    if(!newOpportunities.isEmpty()){
        insert newOpportunities;
    }
}
// When a Case is created on any Account, put the latest case number on the Account in the ‘Latest Case Number’ field.(We assume only case is inserted at a time for account)
trigger updateAccount on Case(after insert){
    Map<Id,String> accountIds = new Map<Id,String>();
    for(Case ca: Trigger.new){
        accountIds.put(ca.AccountId, ca.CaseNumber);
    }

    List<Account> accounts =[SELECT Id, latest_CaseNumber__c FROM Account WHERE Id IN:accountIds.keySet()];
    for(Account acc: accounts){
        if(accountIds.containsKey(acc.Id)){
            acc.latest_CaseNumber__c = accountIds.get(acc.Id);
        }
    }

    if(!accounts.isEmpty()){
        update accounts;
    }
}
//When an account is inserted or updated and the CopyBillingToShipping checkbox is checked then automatically copy the account billing address into account shipping address.
trigger copyAddress on Account(before insert, before update){
    for(Account acc: Trigger.new){
        if(acc.CopyBillingToShipping__c == True){
