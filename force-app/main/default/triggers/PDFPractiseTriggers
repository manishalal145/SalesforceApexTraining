        if(acc.Active__c == 'Yes'){
            acc.addError('This account cannot be deleted');
        }
    }
}
//Prevent account record from being edited if the record is created 7 days back.
trigger validateEdit on Account(before update){
    for(Account acc: Trigger.new){
        if(acc.CreatedDate <= DateTime.now().addDays(-7)){
            acc.addError('This account cannot be edited');
        }
    }
}
