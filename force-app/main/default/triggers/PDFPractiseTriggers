//Write a trigger on Account and check only System Administrator profile users should be able to delete an account.
trigger deleteAccount on Account(before delete){
    //Get Admin Profile Id
    Profile adminProfile = [SELECT Id FROM Profile WHERE Name = 'System Administrator' LIMIT 1];

    //Get current user Profile Id
    Id currentUserProfileId = UserInfo.getProfileId();

    for(Account acc: Trigger.old){
        if(currentUserProfileId != adminProfile.Id){
            acc.addError('Only System Admins can delete the account');
        }
    }
}
//If an opportunity is closed then, no one should be able to delete it except the user having a System Administrator profile
trigger deleteOpp on Opportunity(before delete){
    //Get Admin profile
    Profile AdminProfile = [SELECT Id FROM Profile WHERE Name = 'System Administrator' LIMIT 1];

    // Get the current user's profile ID
    Id currentUserProfileId = UserInfo.getProfileId();

    for(Opportunity opp: Trigger.old){
        if(currentUserProfileId != AdminProfile.Id && (opp.StageName == 'Closed Won' || opp.StageName == 'Closed Lost')){
            opp.addError('Closed opportunity can be deleted by System Administrator only');
        }
    }
}
//Prevent deletion of an account if there is any opportunity related to that account.
trigger preventDeletion on Account(before delete){
    Set<Id> accountIds = new Set<Id>();
    for(Account acc: Trigger.old){
        accountIds.add(acc.Id);
    }

    List<Opportunity> associatedOpps = [SELECT AccountId, StageName FROM Opportunity WHERE AccountId IN: accountIds];
    if(!associatedOpps.isEmpty()){
        Set<Id> accountsWithOpp = new Set<Account>();
        for(Opportunity opp: associatedOpps){
            accountsWithOpp.add(opp.AccountId);
        }   
    }

    for(Account acc: Trigger.old){
        if(accountsWithOpp.contains(acc.Id)){
            acc.addError('Account with Opportunity cannot be deleted')
        }
    }
}
//Prevent deletion of an account if there is any case related to that account.
trigger accountDeletion on Account(before delete){
    Set<Id> accountIds = new Set<Id>();
    for(Account acc: Trigger.old){
        accountIds.add(acc.Id);
    }
    
    Set<Id> accountsWithCases = new Set<Id>();
    if(!accountIds.isEmpty()){
        List<Case> associatedCases = [SELECT AccountId FROM CASE WHERE AccountId IN:accountIds];
        for(Case ca: associatedCases){
            accountsWithCases.add(ca.AccountId);
        }
    }

    for(Account acc: Trigger.old){
        if(accountsWithCases.contains(acc.Id)){
            acc.addError('Account with case(s) cannot be deleted');
        }
    }
}
//When the Contact record is deleted then update ‘Left Contact Count’ on Account.
trigger contactCount on Contact(after delete){

    //Get account ids of contact deleted
    Set<Id> accountIds = new Set<Id>();
    for(Contact con: Trigger.old){
        if(con.AccountId != null){
            accountIds.add(con.AccountId);
        }
    }

    if(accountIds.isEmpty()){
        return;
    }

    //Get a map containing the accountIds and their total contacts now
    Map<Id, Integer> contactCountMap = new Map<Id,Integer>();
    List<AggregateResult> results = [SELECT COUNT(Id)totalContacts, AccountId FROM Contact WHERE AccountId IN:accountIds GROUP BY AccountId];
    for(AggregateResult result : results){
        contactCountMap.put((Id)result.get('AccountId'),(Integer)result.get('totalContacts'));
    }

    //Get the list of accounts whose contacts are deleted
    List<Account> accounts = [SELECT Id, leftContactCount__c FROM Account WHERE Id IN: accountIds];
    for(Account acc: accounts){
        if(contactCountMap.containsKey(acc.Id)){
            acc.leftContactCount__c = contactCountMap.get(acc.Id);
        }else {
            // If no contacts remain, set to 0
            acc.leftContactCount__c = 0;
        }
    }

    if(!accounts.isEmpty()){
        update accounts;
    }
}
//When the conatct record is inserted, or deleted then update ‘Present Contact Count’ on related Account.
trigger updateContactCount on Contact(after insert, after delete){
    Set<Id> accountIds = new Set<Id>();
    if(trigger.isInsert){
        for(Contact con: Trigger.new){
            accountIds.add(con.AccountId);
        }
    }

    if(trigger.isDelete){
        for(Contact con: Trigger.old){
            accountIds.add(con.AccountId);
        }
    }

    if(accountIds.isEmpty()) return;
        
    List<AggregateResult> contactCount = [SELECT COUNT(Id)contactCount, AccountId FROM Contact WHERE AccountId IN:accountIds GROUP BY AccountId];
    Map<Id,Integer>contactCountMap = new Map<Id,Integer>();
    for(AggregateResult ar: contactCount){
        contactCountMap.put((Id)ar.get('AccountId'),(Integer)ar.get('contactCount'));
    }

    List<Account> accounts = [SELECT Id, presentContactCount__c FROM Account WHERE Id IN:accountIds];
    for(Account acc: accounts){
        acc.presentContactCount__c = contactCountMap.containsKey(acc.Id) ? contactCountMap.get(acc.Id) : 0;
    }

    if(!accounts.isEmpty()){
        update accounts;
    }
}
//Create two record types named as “Partner Case” and “Customer Case” on Case Object.On creation of Case, as per the record type populate the total number of Partner Case or Customer Case on Account object. 
trigger updateCount on Case(after insert){
    //GET Account IDs FOR WHICH NEW CASES ARE CREATED
    Set<Id> accountIds = new Set<Id>();
    for(Case ca: Trigger.new){
        accountIds.add(ca.AccountId);
    }

    //GET ACCOUNTS IN A LIST WITH THESE IDs THAT NEED UPDATE
    List<Account> accounts = [SELECT Id, partnerCaseCount__c, customerCaseCount__c FROM Account WHERE Id IN:accountIds];

    Map<Id,Integer> partnerCaseCountMap = new Map<Id,Integer>();
    List<AggregateResult> partnerCaseCount = [SELECT COUNT(Id)partnerCaseCount, AccountId FROM CASE WHERE RecordType.Name = 'Partner Case' AND AccountId IN: accountIds GROUP BY AccountId];
    for(AggregateResult ar: partnerCaseCount){
        partnerCaseCountMap.put((Id)ar.get('AccountId'),(Integer)ar.get('partnerCaseCount'));
    }

    Map<Id,Integer> customerCaseCountMap = new Map<Id,Integer>();
    List<AggregateResult> customerCaseCount = [SELECT COUNT(Id)customerCaseCount, AccountId FROM CASE WHERE RecordType.Name = 'Customer Case' AND AccountId IN: accountIds GROUP BY AccountId];
    for(AggregateResult ar: customerCaseCount){
        customerCaseCountMap.put((Id)ar.get('AccountId'),(Integer)ar.get('customerCaseCount'));
    }
    
    for(Account acc: accounts){
        acc.partnerCaseCount__c = partnerCaseCountMap.containsKey(acc.Id) ? partnerCaseCountMap.get(acc.Id) : 0;
        acc.customerCaseCount__c = customerCaseCountMap.containsKey(acc.Id) ? customerCaseCountMap.get(acc.Id) : 0;
    }

    if(!accounts.isEmpty()){
        update accounts;
    }
} 
//Write a trigger, if the owner of an account is changed then the owner for the related contacts should also be updated.
trigger ownerChange on Account(after update){
    Map<Id,Id> accountIds = new Map<Id,Id>();
    for(Account acc: Trigger.new){
        Account oldValues = Trigger.oldMap.get(acc.Id);
        if(acc.OwnerId != oldValues.OwnerId){
            accountIds.put(acc.Id, acc.OwnerId);
        }
    }

    if(!accountIds.isEmpty()){
        List<Contact> associatedContacts = [SELECT OwnerId, AccountId FROM Contact WHERE AccountId IN:accountIds.keySet()];
        for(Contact con: associatedContacts){
            con.OwnerId = accountIds.get(con.AccountId);
        }
        if(!associatedContacts.isEmpty()){
            update associatedContacts;
        }
    }
}