//Write a trigger, to achieve the following:
 Given: There is any associated Contact to an Account,
 When: User tries to delete the Account,
 Then: User should get the error that Account with associated Contact can not be deleted.

trigger deleteContact on Account (before delete) {
    
    // Collect Account Ids being deleted
    Set<Id> accountIds = new Set<Id>();
    for (Account a : Trigger.old) {
        accountIds.add(a.Id);
    }

    // Query related Contacts
    List<Contact> contacts = [
        SELECT Id, Name, AccountId 
        FROM Contact 
        WHERE AccountId IN :accountIds
    ];

    // Collect Accounts that have Contacts
    Set<Id> accountWithContacts = new Set<Id>();
    for (Contact con : contacts) {
        accountWithContacts.add(con.AccountId);
    }

    // Prevent deletion of Accounts with Contacts
    for (Account a : Trigger.old) {
        if (accountWithContacts.contains(a.Id)) {
            a.addError('Account with associated Contact(s) cannot be deleted.');
        }
    }
}